# macOS
.DS_Store

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# git worktrees created for isolated work
.worktrees/
# local-comments.json

# A scratchpad directory for local files that should not be committed to the repository
local/
# The spec-driven-dev skills are committed as symlinks under .claude/skills/
# (each -> ../../plugin/skills/<name>), so a session in this repo always loads
# the working-tree branch version and no global ~/.claude/skills copy can
# shadow it. plugin/skills/ remains the single source; nothing here is ignored.

# Defensive: bd has been observed writing its global config to a literal
# ./~/ instead of $HOME. The session hook sweeps it; ignore it regardless.
/~/

# Spec CLI index output — a build artifact and cache, never source.
# `spec index` writes it here by default (AC-SPEC-010.1); deleting it is
# always safe, since any changed input triggers a rebuild (AC-SPEC-010.6).
specs/specs.json
